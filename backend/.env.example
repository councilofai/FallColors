# LLM Provider Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=anthropic  # Options: 'anthropic' or 'openai'

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Testing Configuration
DEFAULT_MAX_ROUNDS=10
DEFAULT_ADVERSARIAL_INTENSITY=5  # 1-10 scale
SCREENSHOT_INTERVAL=2  # seconds between screenshots
BROWSER_HEADLESS=False  # Set to True for headless mode

# Database
DATABASE_URL=sqlite:///./chatbot_testbed.db

# Security
SECRET_KEY=your-secret-key-change-this-in-production
